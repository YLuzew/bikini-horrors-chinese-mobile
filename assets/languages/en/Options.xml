<language>
	<str id="optionsMenu.desc-missing">无 描述</str>

	<group name="OptionsMenu">
		<str id="optionsMenu.advanced">高级设置</str>
		<str id="optionsMenu.header.title">设置 菜单</str>
		<str id="optionsMenu.header.desc">选择一个分类以继续。</str>

		<str id="optionsTree.controls-name">键位</str>
		<str id="optionsTree.controls-desc">更改玩家1和玩家2的键位设置！</str>

		<str id="optionsTree.gameplay-name">游戏玩法</str>
		<str id="optionsTree.gameplay-desc">更改游戏玩法选项，例如反向滚动、滚动速度、不雅内容 等…</str>
		<str id="optionsTree.gameplay.advanced-desc">更改更多高级选项，例如流式音频（Streaming Audio）…</str>

		<str id="optionsTree.appearance-name">外观</str>
		<str id="optionsTree.appearance-desc">更改外观选项，例如闪烁菜单 等…</str>
		<str id="optionsTree.appearance.advanced-desc">更改更多高级选项，例如仅显存精灵、抗锯齿、着色器 等。</str>

		<str id="optionsTree.language-name">语言</str>
		<str id="optionsTree.language-desc">更改引擎所使用的语言。</str>

		<str id="optionsTree.miscellaneous-name">杂项</str>
		<str id="optionsTree.miscellaneous-desc">使用此菜单重置存档数据或引擎设置。</str>

		<str id="optionsTree.debug-name">调试项</str>
		<str id="optionsTree.debug-desc">开发者模式的调试选项</str>

		<str id="optionsTree.mobile-name">移动端设置</str>
		<str id="optionsTree.mobile-desc">更改与移动设备或触控控制相关的选项。</str>
	</group>

	<group name="KeybindOptions" prefix="KeybindsOptions.">
