		<str id="category.volume">游戏音量</str>
		<str id="volume.up">增加</str>
		<str id="volume.down">降低</str>
		<str id="volume.mute">静音</str>

		<str id="category.developer">开发者</str>
		<group name="developer" prefix="developer.">
			<str id="devMenus">开发者菜单</str>
			<str id="openConsole">打开控制台</str>
			<str id="reloadState">重新加载</str>
		</group>
	</group>

	<group name="AppearanceOptions" prefix="AppearanceOptions.">
		<str id="framerate-name">最大帧数</str>
		<str id="framerate-desc">这很容易理解，不是吗？</str>

		<str id="flashingMenu-name">主菜单闪光</str>
		<str id="flashingMenu-desc">若未勾选此项，将禁用主菜单中选择选项时的菜单闪烁效果，且其他闪烁效果会变慢。</str>

		<str id="colorHealthBar-name">血条颜色</str>
		<str id="colorHealthBar-desc">若未勾选此项，游戏将使用来自FNF第六周内容的原版 红/绿 色生命值条。</str>

		<str id="week6PixelPerfect-name">完美像素</str>
		<str id="week6PixelPerfect-desc">若勾选此项，第六周或其他像素风格关卡将启用像素完美效果，使屏幕上的每个像素都精准对齐。</str>

		<group name="AppearanceOptionsAdvanced" prefix="Advanced.">
			<str id="quality-name">画质</str>
			<str id="quality-desc">可选择的画质模式：\n“低画质”= 禁用所有占用资源较多的视觉效果，以尽可能让游戏运行更流畅\n“高画质”= 启用所有视觉效果，但会牺牲性能\n“自定义”= 允许使用“高级设置”中提供的自定义选项。</str>
			<str id="quality-low">低画质</str>
			<str id="quality-high">高画质</str>
			<str id="quality-custom">自定义</str>

			<str id="antialiasing-name">抗锯齿</str>
			<str id="antialiasing-desc">若未勾选此项，将禁用所有精灵的抗锯齿。此举可提升性能，但会导致精灵图像边缘更锐利、像素感更强。</str>

			<str id="lowMemoryMode-name">低占用模式</str>
			<str id="lowMemoryMode-desc">若勾选此项，将禁用部分曲目中的背景元素，以减少内存占用。</str>

			<str id="gameplayShaders-name">游戏着色器</str>
			<str id="gameplayShaders-desc">若未勾选此项，游戏着色器（如Thorns的色差效果等视觉效果）将不会加载；这对性能较弱的设备可能有所帮助。</str>

			<str id="gpuOnlyBitmaps-name">显存精灵图</str>
			<str id="gpuOnlyBitmaps-desc">若勾选此项，将仅在图形处理器（GPU）中存储位图，释放大量内存（实验性功能）。关闭此选项会消耗大量内存，尤其是在处理较大精灵图像时。若不确定如何操作，建议保持开启。</str>
		</group>

		<!-- 以下为顶层 gpuOnlyBitmaps，游戏在“外观”主菜单中直接调用 AppearanceOptions.gpuOnlyBitmaps-* -->
		<str id="gpuOnlyBitmaps-name">显存精灵图</str>
		<str id="gpuOnlyBitmaps-desc">若勾选此项，将仅在图形处理器（GPU）中存储位图，释放大量内存（实验性功能）。关闭此选项会消耗大量内存，尤其是在处理较大精灵图像时。若不确定如何操作，建议保持开启。</str>
	</group>

	<group name="MobileOptions" prefix="MobileOptions.">
		<str id="extraButtons-name">额外控件</str>
		<str id="extraButtons-desc">选择你希望在钢琴键上显示的额外按钮数量。</str>

		<str id="extraHints-name">额外提示</str>
		<str id="extraHints-desc">选择你希望在钢琴键上显示的额外提示数量。</str>

		<str id="hitboxAlpha-name">钢琴键透明度</str>
		<str id="hitboxAlpha-desc">更改钢琴键的不透明度。</str>

		<str id="controlsAlpha-name">按键透明度</str>
		<str id="controlsAlpha-desc">更改移动端控件的不透明度。</str>

		<str id="oldPadTexture-name">使用旧版触控板纹理</str>
		<str id="oldPadTexture-desc">若勾选此项，触控板将使用之前的旧纹理。</str>

		<str id="touchPadAlpha-name">触控板透明度</str>
		<str id="touchPadAlpha-desc">更改触控板的不透明度。</str>

		<str id="hitboxType-name">钢琴键样式</str>
		<str id="hitboxType-desc">选择你想要的钢琴键外观！</str>

		<str id="hitboxMode-name">钢琴键模式</str>
		<str id="hitboxMode-desc">选择你的钢琴键样式！（目前无法添加自定义样式）</str>

		<str id="hitboxPos-name">钢琴键位置</str>
		<str id="hitboxPos-desc">若勾选此项，钢琴键将置于屏幕底部，否则将保持在屏幕顶部。</str>

		<str id="screenTimeOut-name">允许屏幕超时</str>
		<str id="screenTimeOut-desc">若勾选此项，当玩家无操作时手机将进入休眠状态。</str>

		<str id="useExternal-name">使用外部文件夹</str>
		<str id="useExternal-desc">若勾选此项，引擎将使用 .CodenameEngine 作为模组和附加组件的文件夹。</str>

		<str id="storageType-name">存储文件</str>
		<str id="storageType-desc">引擎模组应存储在哪个文件夹？\n可以添加自定义文件夹，请查看 android/data 目录。</str>

		<str id="storageTypeChange-title">警告：存储路径已修改</str>
		<str id="storageTypeChange-body">存储类型已变更。\n需要重启游戏方可生效。\n重启后你需要手动将已安装的模组迁移至新的存储目录中。\n\n点击确定以重启游戏并应用更改</str>
	</group>

	<group name="GameplayOptions" prefix="GameplayOptions.">
		<str id="downscroll-name">下落式</str>
		<str id="downscroll-desc">若勾选此项，音符将从上往下移动，如同下落一般。</str>

		<str id="ghostTapping-name">允许空敲</str>
		<str id="ghostTapping-desc">若未勾选此项，空闲时的空敲将判定为失误。</str>

		<str id="naughtyness-name">内容审查</str>
		<str id="naughtyness-desc">若未勾选此项，将对第七周的过场动画或更多内容进行内容屏蔽。</str>

		<str id="camZoomOnBeat-name">镜头按节拍鼓动</str>
		<str id="camZoomOnBeat-desc">若未勾选此项，将阻止镜头每4拍进行一次缩放。</str>

		<str id="autoPause-name">自动暂停</str>
		<str id="autoPause-desc">若勾选此项，切换窗口时将暂停游戏。</str>

		<str id="volumeMusic-name">音乐音量</str>
		<str id="volumeMusic-desc">仅更改音乐的音量，而非所有声音的音量。</str>

		<str id="volumeSFX-name">音效音量</str>
		<str id="volumeSFX-desc">仅更改音效的音量，而非所有声音的音量。</str>

		<str id="songOffset-name">歌曲偏移</str>
		<str id="songOffset-desc">更改歌曲应使用的起始偏移量。</str>

		<group name="GameplayOptionsAdvanced" prefix="Advanced.">
			<str id="windowSize-name">窗口大小</str>
			<str id="windowSize-desc">...</str>

			<str id="streamedMusic-name">流式音乐</str>
			<str id="streamedMusic-desc">若勾选此项，仅音乐将采用流式音乐（处理），这同样能释放大量内存，但缺点是若同时流式传输多个音频，会导致CPU占用率升高（实验性功能）。关闭此选项会消耗大量内存，尤其是在播放较长歌曲时。若不确定如何操作，建议保持开启。</str>

			<str id="streamedVocals-name">流式人声</str>
			<str id="streamedVocals-desc">若勾选此项，且“流式音乐”选项已勾选，人声也将采用流式传输，若歌曲包含大量人声，此功能可能会影响性能（实验性功能）。若不确定如何操作，建议保持关闭。</str>
		</group>
	</group>

	<group name="LanguageOptions" prefix="LanguageOptions.">
		<str id="language-name">语言</str>
		<str id="language-desc">当前语言由 {0} （当前语言版本： {1}）</str>
	</group>

	<group name="MiscOptions" prefix="MiscOptions.">
		<str id="forceCrash-name">强制崩溃</str>
		<str id="forceCrash-desc">选择此选项可强制触发崩溃。</str>

		<str id="betaUpdates-name">每日内测更新</str>
		<str id="betaUpdates-desc">若勾选此项，更新检查中还将包含每日构建版本（本质上是引擎代码仓库的提交更新，使用Actions构建功能生成）。</str>

		<str id="checkForUpdates-name">检查版本更新</str>
		<str id="checkForUpdates-desc">点击以检查引擎是否有新更新。</str>
		<str id="checkForUpdates-noUpdateFound">未检查到 新版本。</str>

		<str id="devMode-name">开发者模式</str>
		<str id="devMode-desc">若勾选此项，你将能够访问开发者功能，例如特定按键绑定、编辑器、开发者选项、状态重载、控制台等。</str>

		<str id="allowConfigWarning-name">显示模组包警告</str>
		<str id="allowConfigWarning-desc">若勾选此项，若模组包存在部分警告（如缺少配置文件、版本不兼容等），游戏启动时将弹出提示窗口。</str>

		<str id="resetSaveData-name">清除成绩记录</str>
		<str id="resetSaveData-desc">选择此选项可重置存档数据。此操作将清除你的所有最高分记录。</str>
	</group>

	<group name="DebugOptions" prefix="DebugOptions.">
		<str id="title">调试 选项</str>
		<str id="desc">使用此菜单启用或禁用调试选项。</str>

		<str id="showConsole-name">显示控制台</str>
		<str id="showConsole-desc">选中此项可显示调试控制台，该控制台包含游戏的日志信息。</str>

		<str id="editorsResizable-name">可调整大小的编辑器</str>
		<str id="editorsResizable-desc">若勾选此项，这将允许编辑器渲染超出FNF基础的1280x720分辨率（从而获得更多细节和空间…）</str>

		<str id="bypassEditorsResize-name">绕过编辑器窗口缩放</str>
		<str id="bypassEditorsResize-desc">禁用编辑器调整大小时的最小分辨率限制（需先启用“可调整大小的编辑器（Resizable Editors）功能）。</str>

		<str id="editorSFX-name">编辑器音效</str>
		<str id="editorSFX-desc">若勾选此项，在编辑器中操作时会播放音效（例如：勾选复选框时会播放音效…）</str>

		<str id="editorCharterPrettyPrint-name">谱面格式化输出</str>
		<str id="editorCharterPrettyPrint-desc">若勾选此项，从谱面编辑器保存的文件将被格式化为易于查看的形式。</str>

		<str id="editorCharacterPrettyPrint-name">人物格式化输出</str>
		<str id="editorCharacterPrettyPrint-desc">若勾选此项，从人物编辑器保存的文件将被格式化为易于查看的形式。</str>

		<str id="editorStagePrettyPrint-name">背景格式化输出</str>
		<str id="editorStagePrettyPrint-desc">若勾选此项，从背景编辑器保存的文件将被格式化为易于查看的形式。</str>

		<str id="intensiveBlur-name">极致模糊</str>
		<str id="intensiveBlur-desc">若勾选此项，将使用效果更强的模糊处理，这可能会更卡顿，但视觉效果更好。</str>

		<str id="charterAutoSaves-name">编辑器自动保存</str>
		<str id="charterAutoSaves-desc">若勾选此项，此功能将根据下方列出的设置，在编辑器中自动保存你的文件。</str>

		<str id="charterAutoSaveTime-name">自动保存倒计时</str>
		<str id="charterAutoSaveTime-desc">此选项控制编辑器自动保存文件的频率（以秒为单位…）</str>

		<str id="charterAutoSaveWarningTime-name">自动保存警告倒计时</str>
		<str id="charterAutoSaveWarningTime-desc">此选项控制编辑器在自动保存前向你发出提醒的时长（以秒为单位…，设为0则禁用提醒）。</str>

		<str id="charterAutoSavesSeparateFolder-name">自动保存文件夹</str>
		<str id="charterAutoSavesSeparateFolder-desc">若勾选此项，此功能会将你的文件自动保存在一个带有时间戳的单独文件夹中，而非覆盖当前文件\n（路径：song/autosaves/）。</str>

		<str id="songOffsetAffectEditors-name">谱编器同偏移</str>
		<str id="songOffsetAffectEditors-desc">若勾选此项，此功能也将在谱面编辑器中启用“歌曲偏移”选项。</str>
	</group>

</language>