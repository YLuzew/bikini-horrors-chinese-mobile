		<str id="category.ui">UI界面</str>
		<group name="ui" prefix="ui.">
			<str id="accept">确认键</str>
			<str id="back">返回键</str>
			<str id="reset">重开键</str>
			<str id="pause">暂停键</str>
			<str id="changeMode">修改模式</str>
		</group>

		<str id="category.engine">引擎</str>
		<group name="engine" prefix="engine.">
			<str id="switchMod">切换模组</str>
			<str id="fpsCounter">帧率显示</str>
